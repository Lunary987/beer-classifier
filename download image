# Input your image

from PIL import Image
from torchvision import transforms
from torchvision.transforms import v2
#input here image with beer()

import torch
from torchvision import models

transform = v2.Compose([
    v2.Resize(256),
    v2.RandomResizedCrop(224),
    v2.RandomHorizontalFlip(p=0.5),
    v2.RandomRotation(degrees=15),
    v2.ToImage(),
    v2.ToDtype(torch.float32, scale=True),
    v2.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
])


image = Image.open('YOUR FILE IS HERE').convert('RGB')
tensor = transform(image)
input_tensor = tensor.unsqueeze(0)


model = models.resnet18(weights = None)
model.fc= torch.nn.Linear(model.fc.in_features, 6)

model.load_state_dict(torch.load("model_weights.pth", weights_only=True))
model.eval()


with torch.no_grad():  
    output = model(input_tensor)
    pr = torch.softmax(output, dim = 1)
    pred_class = torch.argmax(pr, dim = 1)

class_names = ['carlsberg', 'chimay', 'corona', 'fosters', 'guiness', 'tsingtao'] 
print(class_names[pred_class.item()])
